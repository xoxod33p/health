# ==============================================================================
# CareSignal - Production Environment Variables Template
# ==============================================================================

# Core Application Settings
NODE_ENV=production
PORT=3001
DOMAIN_NAME=yourdomain.com
WEB_ORIGIN=https://yourdomain.com
JWT_SECRET=replace_with_a_super_strong_random_jwt_secret_min_32_characters!

# Public Next.js Frontend URL Configuration
NEXT_PUBLIC_API_URL=https://yourdomain.com/api/v1

# MongoDB 8.0 Database Credentials
MONGO_ROOT_USERNAME=healthcare
MONGO_ROOT_PASSWORD=replace_with_a_secure_mongo_password_123!
MONGO_DATABASE=healthcare
MONGODB_URI=mongodb://healthcare:replace_with_a_secure_mongo_password_123!@mongodb:27017/healthcare?authSource=admin

# Redis 7.4 Caching & WebSocket Queue
REDIS_PASSWORD=replace_with_a_secure_redis_password_123!
REDIS_URL=redis://:replace_with_a_secure_redis_password_123!@redis:6379

# Storage Path (Persistent Volume Mounted at /app/storage in Docker)
STORAGE_PATH=/app/storage

# Default System Administrator Credentials
DEFAULT_ADMIN_EMAIL=admin@yourdomain.com
DEFAULT_ADMIN_PASSWORD=CareSignalAdmin2026!
DEFAULT_ADMIN_ROLE=SYSTEM_ADMIN
DEFAULT_ADMIN_COMPANY_ID=caresignal-production

