# Application Settings
NODE_ENV=production
PORT=3001
DOMAIN_NAME=yourdomain.com
WEB_ORIGIN=https://yourdomain.com

# MongoDB Database Configuration
MONGO_ROOT_USERNAME=healthcare_prod_user
MONGO_ROOT_PASSWORD=replace_with_secure_mongo_password_here
MONGO_DATABASE=healthcare_prod
MONGODB_URI=mongodb://healthcare_prod_user:replace_with_secure_mongo_password_here@mongodb:27017/healthcare_prod?authSource=admin

# Redis Cache & Queue Configuration
REDIS_PASSWORD=replace_with_secure_redis_password_here
REDIS_URL=redis://:replace_with_secure_redis_password_here@redis:6379

# MinIO Object Storage (S3 Compatible Storage)
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=replace_with_secure_minio_access_key
MINIO_SECRET_KEY=replace_with_secure_minio_secret_key
MINIO_USE_SSL=false

# Supabase Authentication Services
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SECRET_KEY=your_supabase_secret_key
SUPABASE_JWKS_URL=https://your-project-id.supabase.co/rest/v1/
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Email Notification & APM Monitoring Services
RESEND_API_KEY=re_your_resend_api_key_here
SENTRY_DSN=https://your_sentry_dsn_here

# Initial Admin Bootstrap (Optional for initial bootstrap)
DEFAULT_ADMIN_EMAIL=admin@yourdomain.com
DEFAULT_ADMIN_PASSWORD=ChangeThisPasswordInProd123!
DEFAULT_ADMIN_ROLE=COMPANY_ADMIN
DEFAULT_ADMIN_COMPANY_ID=production-company
