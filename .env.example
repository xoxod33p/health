# Application Settings
NODE_ENV=development
PORT=3001
DOMAIN_NAME=localhost
WEB_ORIGIN=http://localhost:3000
JWT_SECRET=your_jwt_secret_32_chars_long_minimum_key!

# Frontend Next.js Public Environment Variables
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# MongoDB Database Configuration
MONGO_ROOT_USERNAME=healthcare
MONGO_ROOT_PASSWORD=healthcare_dev_only
MONGO_DATABASE=healthcare
MONGODB_URI=mongodb://healthcare:healthcare_dev_only@localhost:27017/healthcare?authSource=admin

# Redis Cache & Queue Configuration
REDIS_PASSWORD=redis_dev_only
REDIS_URL=redis://:redis_dev_only@localhost:6379

# MinIO Object Storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minio_dev_only
MINIO_SECRET_KEY=minio_dev_only
MINIO_USE_SSL=false

# Email & Monitoring Services
RESEND_API_KEY=
SENTRY_DSN=

# Initial Bootstrap Admin Account
DEFAULT_ADMIN_EMAIL=admin@localhost.test
