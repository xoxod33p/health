{
  "name": "healthcare-sensor-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@10",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:api": "npm --workspace apps/api run start:dev",
    "dev:web": "npm --workspace apps/web run dev",
    "user:list": "npx tsx apps/api/src/scripts/manage-roles.ts list",
    "user:set-role": "npx tsx apps/api/src/scripts/manage-roles.ts set-role",
    "user:set-permissions": "npx tsx apps/api/src/scripts/manage-roles.ts set-permissions",
    "user:create": "npx tsx apps/api/src/scripts/manage-roles.ts create"
  }
}
